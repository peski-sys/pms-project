model uploads {
  upload_id            Int                    @id @default(autoincrement())
  file_name            String?                @db.VarChar(255)
  uploaded_at          DateTime?              @default(now()) @db.Timestamp(6)
  is_confirmed         Boolean?               @default(false)
  buy_records          buy_records[]
  buy_records_staging  buy_records_staging[]
  order_book           order_book[]
  pdf_records          pdf_records[]
  sell_records         sell_records[]
  sell_records_staging sell_records_staging[]
}

model users {
  user_password String @db.VarChar(100)
  user_email    String @id @db.VarChar(150)
  user_id       Int    @default(autoincrement())
}

model fiscal_year_balance {
  client_id             String                @db.VarChar(25)
  symbol                String                @db.VarChar(15)
  fiscal_year_id        Int
  opening_quantity      Int?                  @default(0)
  added_quantity        Int?                  @default(0)
  closing_quantity      Int?                  @default(dbgenerated("(opening_quantity + added_quantity)"))
  effective_rate        Decimal?              @db.Decimal(14, 2)
  remarks               String?               @default("") @db.VarChar(300)
  opening_rate          Decimal?              @default(0) @db.Decimal(14, 2)
  demat                 Int?                  @default(0)
  non_demat             Int?                  @default(dbgenerated("((opening_quantity + added_quantity) - demat)"))
  fund_id               Int
  source_type           String?               @default("TRADING") @db.VarChar(50)
  sub_id                Int?                  @default(1)
  client_broker_mapping client_broker_mapping @relation(fields: [client_id], references: [client_id], onDelete: NoAction, onUpdate: NoAction)
  fiscal_years          fiscal_years          @relation(fields: [fiscal_year_id], references: [fiscal_year_id], onDelete: NoAction, onUpdate: NoAction)
  funds                 funds                 @relation(fields: [fund_id], references: [fund_id], onDelete: NoAction, onUpdate: NoAction)
  sub_classes           sub_classes?          @relation(fields: [sub_id], references: [sub_id], onDelete: NoAction, onUpdate: NoAction)
  stock_fulls           stock_fulls           @relation(fields: [symbol], references: [symbol], onDelete: NoAction, onUpdate: NoAction)

  @@id([client_id, symbol, fiscal_year_id])
}

