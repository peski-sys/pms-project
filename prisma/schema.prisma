generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model audit_log {
  performed_action String    @db.VarChar(150)
  date_time        DateTime? @default(now()) @db.Timestamp(6)
  audit_id         Int       @id @default(autoincrement())
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model buy_records {
  fund_id               Int
  upload_id             Int
  client_id             String                @db.VarChar(25)
  symbol                String                @db.VarChar(15)
  quantity              Int
  price                 Decimal               @db.Decimal(12, 2)
  txn_value             Decimal               @db.Decimal(16, 2)
  commission_rate       String?               @default("") @db.VarChar(10)
  commission_amount     Decimal?              @default(0) @db.Decimal(10, 2)
  sebon_commission      Decimal?              @default(0) @db.Decimal(10, 2)
  effective_rate        Decimal?              @default(0) @db.Decimal(10, 2)
  net_payable           Decimal?              @default(0) @db.Decimal(16, 2)
  transaction_date      DateTime              @db.Timestamp(6)
  recorded_at           DateTime?             @default(now()) @db.Timestamp(6)
  contract_number       String                @id @db.VarChar(100)
  fiscal_year_id        Int?
  client_broker_mapping client_broker_mapping @relation(fields: [client_id], references: [client_id], onDelete: Cascade)
  fiscal_years          fiscal_years?         @relation(fields: [fiscal_year_id], references: [fiscal_year_id], onDelete: NoAction, onUpdate: NoAction)
  funds                 funds                 @relation(fields: [fund_id], references: [fund_id], onDelete: NoAction, onUpdate: NoAction)
  stock_fulls           stock_fulls           @relation(fields: [symbol], references: [symbol], onDelete: Cascade)
  uploads               uploads               @relation(fields: [upload_id], references: [upload_id], onDelete: Cascade, onUpdate: NoAction)
}

model client_broker_mapping {
  client_id                                                           String                  @id @db.VarChar(25)
  fund_id                                                             Int
  client_name                                                         String                  @db.VarChar(100)
  client_broker                                                       Int
  recorded_at                                                         DateTime?               @default(now()) @db.Timestamp(6)
  boid                                                                String?                 @db.VarChar(100)
  bonus_records                                                       bonus_records[]
  buy_records                                                         buy_records[]
  buy_records_staging                                                 buy_records_staging[]
  cash_records                                                        cash_records[]
  client_boid_mapping_client_broker_mapping_boidToclient_boid_mapping client_boid_mapping?    @relation("client_broker_mapping_boidToclient_boid_mapping", fields: [boid], references: [boid], onDelete: NoAction, onUpdate: NoAction)
  funds                                                               funds                   @relation(fields: [fund_id], references: [fund_id], onDelete: NoAction, onUpdate: NoAction)
  closeout_records                                                    closeout_records[]
  fiscal_year_balance                                                 fiscal_year_balance[]
  ipo_allotment_records                                               ipo_allotment_records[]
  order_book                                                          order_book[]
  promoter_records                                                    promoter_records[]
  right_records                                                       right_records[]
  sell_records                                                        sell_records[]
  sell_records_staging                                                sell_records_staging[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model order_book {
  upload_id             Int
  contract_number       String                @id @db.VarChar(100)
  client_id             String                @db.VarChar(25)
  symbol                String                @db.VarChar(15)
  transaction_type      String                @db.VarChar(10)
  quantity              Int
  price                 Decimal               @db.Decimal(12, 2)
  txn_value             Decimal               @db.Decimal(16, 2)
  transaction_date      DateTime              @db.Timestamp(6)
  recorded_at           DateTime?             @default(now()) @db.Timestamp(6)
  fiscal_year_id        Int?
  client_broker_mapping client_broker_mapping @relation(fields: [client_id], references: [client_id], onDelete: NoAction, onUpdate: NoAction)
  fiscal_years          fiscal_years?         @relation(fields: [fiscal_year_id], references: [fiscal_year_id], onDelete: NoAction, onUpdate: NoAction)
  stock_fulls           stock_fulls           @relation(fields: [symbol], references: [symbol], onDelete: NoAction, onUpdate: NoAction)
  uploads               uploads               @relation(fields: [upload_id], references: [upload_id], onDelete: Cascade, onUpdate: NoAction)
}

