  recorded_at          DateTime?    @default(now()) @db.Timestamp(6)
  added_at             DateTime     @db.Date
  remarks              String?      @db.VarChar(300)
  symbol               String       @db.VarChar(15)
  sub_id               Int
  fiscal_years         fiscal_years @relation(fields: [fiscal_year_id], references: [fiscal_year_id], onDelete: NoAction, onUpdate: NoAction)
  funds                funds        @relation(fields: [fund_id], references: [fund_id], onDelete: NoAction, onUpdate: NoAction)
  sub_classes          sub_classes  @relation(fields: [sub_id], references: [sub_id], onDelete: NoAction, onUpdate: NoAction)
  stock_fulls          stock_fulls  @relation(fields: [symbol], references: [symbol], onDelete: NoAction, onUpdate: NoAction)
}
